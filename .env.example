# Set one API key. Nexus uses the first one it finds in this order:
# Gemini, Anthropic, OpenAI. With no key at all it uses a local Ollama model.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider (gemini, anthropic, openai or ollama)
LLM_PROVIDER=

# Optional: change the model for a provider
# GEMINI_MODEL=gemini-3.5-flash-lite
# Other Gemini models to try when that one is busy or out of quota, separated by commas.
# Leave this empty for evals, so every pipeline is compared on the same model.
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.4-mini
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434

# Optional: how PDFs are read. pypdf is light and fast. docling keeps tables
# and reads scanned pages, but needs: pip install -r requirements-docling.txt
# PDF_PARSER=pypdf

# Optional: the agent checks each answer against its sources, using one more LLM call.
# ANSWER_CHECK=false turns it off, for example to stay within a free tier's limits.
# ANSWER_CHECK=true

# Optional tokens for the connectors. Public repositories work without them,
# but GitHub allows only 60 requests per hour without a token.
# Any personal token works, it needs no scopes. With the GitHub CLI: gh auth token
GITHUB_TOKEN=
GITLAB_TOKEN=
